{
  "name": "homebridge-daikin-local-platform",
  "displayName": "Homebridge Daikin Local Platform",
  "version": "2.1.2",
  "description": "Homebridge platform plugin providing HomeKit and Matter support for Daikin air conditioners with local control",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tasict/homebridge-daikin-local-platform.git"
  },
  "bugs": {
    "url": "https://github.com/tasict/homebridge-daikin-local-platform/issues"
  },
  "homepage": "https://tasict.github.io/homebridge-daikin-local-platform/",
  "funding": [
    {
      "type": "individual",
      "url": "https://tasict.bobaboba.me"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/tasict"
    }
  ],
  "engines": {
    "homebridge": "^2.4.0",
    "node": "^22 || ^24 || ^26"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/test.*",
    "!dist/energy-ledger-check.*",
    "homebridge-ui",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "lint": "eslint src/**.ts --max-warnings=0",
    "build": "npm run clean && tsc",
    "build-watch": "npm run clean && tsc -w",
    "prepublishOnly": "npm run lint && npm run build",
    "postpublish": "npm run clean"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homebridge-daikin-local-platform",
    "homekit",
    "Daikin",
    "ac",
    "air conditioner",
    "daikin",
    "daikin local",
    "supports-hap",
    "supports-matter"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "axios": "^1.20.0",
    "axios-rate-limit": "^1.9.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
